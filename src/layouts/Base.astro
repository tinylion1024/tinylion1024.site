---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const analyticsScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const analyticsWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const {
  title = "tinylion1024",
  description = "AI 时代的极简产品实践：用 AI 构建产品，用真实增长验证判断。",
  current = "/",
  lang = "zh-CN",
  languageUrl = "/en/",
  alternates = [],
  type = "website",
  image = "/og/default.png",
  headline = title,
  publishedTime,
  articleSection,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon = `${import.meta.env.BASE_URL}avatar.png`;
const socialImage = new URL(image, Astro.site);
const rss = new URL(lang === "en" ? "/en/rss.xml" : "/rss.xml", Astro.site);
const structuredData = type === "article"
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline,
      description,
      image: socialImage.href,
      datePublished: publishedTime,
      dateModified: publishedTime,
      inLanguage: lang,
      articleSection,
      author: {
        "@type": "Person",
        name: "tinylion1024",
        url: new URL("/about", Astro.site).href,
      },
      publisher: {
        "@type": "Person",
        name: "tinylion1024",
        url: new URL("/", Astro.site).href,
      },
      mainEntityOfPage: canonical.href,
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "tinylion1024",
      description,
      inLanguage: lang,
      url: canonical.href,
      author: {
        "@type": "Person",
        name: "tinylion1024",
        url: new URL("/about", Astro.site).href,
      },
    };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="tinylion1024" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="apple-touch-icon" href={favicon} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="tinylion1024 RSS" href={rss} />
    {alternates.map((alternate: { lang: string; href: string }) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((alternate: { lang: string }) => alternate.lang === "zh-CN")?.href ?? "/", Astro.site)} />
    )}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="tinylion1024" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "zh_CN"} />
    <meta property="og:title" content={headline} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="tinylion1024 — AI × PRODUCT × LESS" />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={headline} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {analyticsScript && analyticsWebsiteId && (
      <script
        is:inline
        defer
        src={analyticsScript}
        data-website-id={analyticsWebsiteId}
        data-do-not-track="true"
      ></script>
    )}
    <title>{title}</title>
  </head>
  <body>
    <div class="paper-grain"></div>
    <div class="shell">
      <Header current={current} lang={lang} languageUrl={languageUrl} />
      <main><slot /></main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
