---
const { current = "/" } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path}`;
const links = [
  { href: link(), label: "首页" },
  { href: link("posts"), label: "文章" },
  { href: link("about"), label: "关于" },
];
---

<header class="site-header">
  <a class="wordmark" href={link()} aria-label="tinylion1024 首页">
    <span>@tinylion1024</span>
  </a>
  <nav aria-label="主导航">
    {links.map((link) => <a href={link.href} class:list={[{ active: current === link.href }]}>{link.label}</a>)}
  </nav>
  <button class="theme-button" type="button" aria-label="切换夜间模式">◐</button>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-button");
  button?.addEventListener("click", () => document.documentElement.classList.toggle("night"));
</script>
