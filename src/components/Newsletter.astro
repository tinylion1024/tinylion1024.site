---
const { lang = "zh-CN" } = Astro.props;
const isEnglish = lang === "en";
const subject = encodeURIComponent(isEnglish ? "Subscribe to tinylion1024" : "订阅 tinylion1024");
const body = encodeURIComponent(isEnglish
  ? "Please add me to the update list. I understand this is a manual, low-frequency email."
  : "请把我加入更新列表。我了解这是人工维护的低频邮件。");
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <div>
    <span class="eyebrow">{isEnglish ? "LOW-FREQUENCY NOTES" : "低频通信"}</span>
    <h2 id="newsletter-title">{isEnglish ? "New essays, no feed anxiety." : "只在有新观点时写信。"}</h2>
    <p>{isEnglish
      ? "A manual, low-frequency update. No tracking pixels, no automated funnel."
      : "人工维护、低频发送。不放追踪像素，也不做自动化营销漏斗。"}</p>
  </div>
  <a href={`mailto:shaowei_job@163.com?subject=${subject}&body=${body}`}>
    {isEnglish ? "Subscribe by email" : "通过邮件订阅"} <span>↗</span>
  </a>
</section>
