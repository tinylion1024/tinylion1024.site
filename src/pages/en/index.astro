---
import Base from "../../layouts/Base.astro";
import Newsletter from "../../components/Newsletter.astro";
import { postsEn } from "../../data/posts.en";
import { topicAccent } from "../../data/posts";

const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path.replace(/^\//, "")}`;
const startHere = postsEn.filter((post) => post.startHere).slice(0, 3);
const latestPosts = postsEn.slice(0, 4);
---

<Base
  title="tinylion1024 — Minimalist AI Product Builder"
  description="Less complexity. More value. Build products with AI and test judgment through real growth."
  current="/en/"
  lang="en"
  languageUrl="/"
  alternates={[{ lang: "zh-CN", href: "/" }, { lang: "en", href: "/en/" }]}
>
  <section class="hero">
    <img class="avatar" src={link("avatar.png")} alt="Pixel lion avatar for tinylion1024" width="460" height="460" />
    <div class="hero-copy">
      <div class="hero-kicker">AI × PRODUCT × LESS</div>
      <h1>Less complexity. More value.</h1>
      <p>Hi, I’m @tinylion1024, a minimalist AI product builder. I build products with AI and test judgment through real growth.</p>
      <div class="hero-foot">
        <p class="hero-manifesto">Keep it simple. Ship what matters.</p>
        <div class="social-links"><a href="https://github.com/tinylion1024" target="_blank" rel="noreferrer">GitHub</a><a href="mailto:shaowei_job@163.com">Email</a><a href={link("en/about")}>About</a></div>
      </div>
    </div>
  </section>

  <section class="start-section" aria-labelledby="start-here">
    <div class="section-heading">
      <div><span class="eyebrow">START HERE</span><h2 id="start-here">Start here</h2></div>
      <p>Three pieces that explain how I approach AI, products, and minimalist building.</p>
    </div>
    <div class="start-grid">
      {startHere.map((post, index) => (
        <a href={link(`en/posts/${post.slug}`)}>
          <span>{String(index + 1).padStart(2, "0")} / {post.series}</span>
          <h3>{post.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="latest-section">
    <div class="section-label">Latest writing</div>
    <div class="post-list">
      {latestPosts.map((post) => (
        <article class="post-row">
          <div>
            <div class="post-meta"><span style={`--accent:${topicAccent[post.topic]}`}>{post.topic}</span><time>{post.date} · {post.readTime}</time></div>
            <h3><a href={link(`en/posts/${post.slug}`)}>{post.title}</a></h3>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={link("en/posts")}>All posts <span>→</span></a>
  </section>
  <Newsletter lang="en" />
</Base>
