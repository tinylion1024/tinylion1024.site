---
import Base from "../../../layouts/Base.astro";
import ArticleFooter from "../../../components/ArticleFooter.astro";
import { postsEn } from "../../../data/posts.en";

export function getStaticPaths() {
  return postsEn.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path.replace(/^\//, "")}`;
const visualsAfter = (paragraph: number) => post.visuals?.filter((visual) => visual.afterParagraph === paragraph) ?? [];
const chinesePath = post.translationOf ? `/posts/${post.translationOf}` : "/posts";
const postIndex = postsEn.findIndex((candidate) => candidate.slug === post.slug);
const previousPost = postIndex > 0 ? postsEn[postIndex - 1] : undefined;
const nextPost = postIndex < postsEn.length - 1 ? postsEn[postIndex + 1] : undefined;
const seriesPosts = post.seriesSlug ? postsEn.filter((candidate) => candidate.seriesSlug === post.seriesSlug && candidate.slug !== post.slug) : [];
const publishedTime = post.date.replaceAll(".", "-");
---

<Base title={`${post.title} — tinylion1024`} headline={post.title} description={post.summary} current="/en/posts" lang="en" languageUrl={chinesePath} alternates={[{ lang: "zh-CN", href: chinesePath }, { lang: "en", href: `/en/posts/${post.slug}` }]} type="article" publishedTime={publishedTime} articleSection={post.topic}>
  <article class="essay">
    <a class="back-link" href={link("en/posts")}>← Back to posts</a>
    <h1>{post.title}</h1>
    <div class="post-meta"><time>{post.date} · {post.readTime}</time></div>
    <p class="dek">{post.summary}</p>
    <div class="essay-rule"></div>
    <div class="prose">
      {post.body.map((paragraph, index) => {
        const highlight = post.highlights?.find((term) => paragraph.includes(term));
        const highlightIndex = highlight ? paragraph.indexOf(highlight) : -1;
        return (
        <>
          <p>{highlight ? <>{paragraph.slice(0, highlightIndex)}<mark class="key-phrase">{highlight}</mark>{paragraph.slice(highlightIndex + highlight.length)}</> : paragraph}</p>
          {visualsAfter(index + 1).map((visual) => (
            <figure class="article-visual">
              <img src={link(visual.src)} alt={visual.alt} loading="lazy" width="1672" height="941" />
              <figcaption>{visual.caption}</figcaption>
            </figure>
          ))}
        </>
        );
      })}
    </div>
    {post.sources && (
      <aside class="article-sources">
        <p>Sources and data</p>
        <ol>
          {post.sources.map((source) => <li><a href={source.href} target="_blank" rel="noreferrer">{source.label}</a></li>)}
        </ol>
      </aside>
    )}
    <p class="essay-end">— End —</p>
    <ArticleFooter lang="en" currentPost={post} previousPost={previousPost} nextPost={nextPost} seriesPosts={seriesPosts} />
  </article>
</Base>
