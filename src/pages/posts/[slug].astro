---
import Base from "../../layouts/Base.astro";
import { posts, topicAccent } from "../../data/posts";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}/${path}`;
const visualsAfter = (paragraph: number) => post.visuals?.filter((visual) => visual.afterParagraph === paragraph) ?? [];
---

<Base title={`${post.title} — Tinylion Journal`} description={post.summary} current="/posts">
  <article class="essay">
    <a class="back-link" href={link("posts")}>← 回到文章列表</a>
    <div class="post-meta"><span style={`--accent:${topicAccent[post.topic]}`}>{post.topic}</span><time>{post.date} · {post.readTime}</time></div>
    <h1>{post.title}</h1>
    <p class="dek">{post.summary}</p>
    <div class="essay-rule"></div>
    <div class="prose">
      {post.body.map((paragraph, index) => (
        <>
          <p>{paragraph}</p>
          {visualsAfter(index + 1).map((visual) => (
            <figure class="article-visual">
              <img src={`${base}${visual.src}`} alt={visual.alt} loading="lazy" width="1672" height="941" />
              <figcaption>{visual.caption}</figcaption>
            </figure>
          ))}
        </>
      ))}
    </div>
    <p class="essay-end">— 完 —</p>
  </article>
</Base>
