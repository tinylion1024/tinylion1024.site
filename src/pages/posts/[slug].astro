---
import Base from "../../layouts/Base.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";
import { posts, topicAccent } from "../../data/posts";
import { postsEn } from "../../data/posts.en";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path.replace(/^\//, "")}`;
const visualsAfter = (paragraph: number) => post.visuals?.filter((visual) => visual.afterParagraph === paragraph) ?? [];
const englishPost = postsEn.find((candidate) => candidate.translationOf === post.slug);
const englishPath = englishPost ? `/en/posts/${englishPost.slug}` : "/en/posts";
const alternates = [{ lang: "zh-CN", href: `/posts/${post.slug}` }, ...(englishPost ? [{ lang: "en", href: englishPath }] : [])];
const postIndex = posts.findIndex((candidate) => candidate.slug === post.slug);
const previousPost = postIndex > 0 ? posts[postIndex - 1] : undefined;
const nextPost = postIndex < posts.length - 1 ? posts[postIndex + 1] : undefined;
const seriesPosts = post.seriesSlug ? posts.filter((candidate) => candidate.seriesSlug === post.seriesSlug && candidate.slug !== post.slug) : [];
const publishedTime = post.date.replaceAll(".", "-");
---

<Base title={`${post.title} — tinylion1024`} headline={post.title} description={post.summary} current="/posts" languageUrl={englishPath} alternates={alternates} type="article" publishedTime={publishedTime} articleSection={post.topic}>
  <article class="essay">
    <a class="back-link" href={link("posts")}>← 回到文章列表</a>
    <div class="post-meta"><span style={`--accent:${topicAccent[post.topic]}`}>{post.topic}</span><time>{post.date} · {post.readTime}</time>{post.series && <em>{post.series}</em>}</div>
    <h1>{post.title}</h1>
    <p class="dek">{post.summary}</p>
    <div class="essay-rule"></div>
    <div class="prose">
      {post.body.map((paragraph, index) => {
        const highlight = post.highlights?.find((term) => paragraph.includes(term));
        const highlightIndex = highlight ? paragraph.indexOf(highlight) : -1;
        return (
        <>
          <p>{highlight ? <>{paragraph.slice(0, highlightIndex)}<mark class="key-phrase">{highlight}</mark>{paragraph.slice(highlightIndex + highlight.length)}</> : paragraph}</p>
          {visualsAfter(index + 1).map((visual) => (
            <figure class="article-visual">
              <img src={link(visual.src)} alt={visual.alt} loading="lazy" width="1672" height="941" />
              <figcaption>{visual.caption}</figcaption>
            </figure>
          ))}
        </>
        );
      })}
    </div>
    {post.sources && (
      <aside class="article-sources">
        <p>数据与参考</p>
        <ol>
          {post.sources.map((source) => <li><a href={source.href} target="_blank" rel="noreferrer">{source.label}</a></li>)}
        </ol>
      </aside>
    )}
    <p class="essay-end">— 完 —</p>
    <ArticleFooter currentPost={post} previousPost={previousPost} nextPost={nextPost} seriesPosts={seriesPosts} />
  </article>
</Base>
