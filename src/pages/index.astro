---
import Base from "../layouts/Base.astro";
import { posts, topicAccent } from "../data/posts";

const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path}`;
const startHere = posts.filter((post) => post.startHere).slice(0, 3);
const latestPosts = posts.slice(0, 4);
---

<Base
  title="tinylion1024 — AI 时代的极简产品实践者"
  description="少一点复杂，多一点价值。用 AI 构建产品，用真实增长验证判断。"
  languageUrl="/en/"
  alternates={[{ lang: "zh-CN", href: "/" }, { lang: "en", href: "/en/" }]}
>
  <section class="hero">
    <img class="avatar" src={link("avatar.png")} alt="tinylion1024 的像素风狮子头像" width="460" height="460" />
    <div class="hero-copy">
      <div class="hero-kicker">AI × PRODUCT × LESS</div>
      <h1>少一点复杂，多一点价值。</h1>
      <p>你好，我是 @tinylion1024，AI 时代的极简产品实践者。用 AI 构建产品，用真实增长验证判断。</p>
      <div class="hero-foot">
        <p class="hero-manifesto">保持简单，只交付真正重要的东西。</p>
        <div class="social-links"><a href="https://github.com/tinylion1024" target="_blank" rel="noreferrer">GitHub</a><a href="mailto:shaowei_job@163.com">Email</a><a href={link("about")}>About</a></div>
      </div>
    </div>
  </section>

  <section class="start-section" aria-labelledby="start-here">
    <div class="section-heading">
      <div><span class="eyebrow">START HERE</span><h2 id="start-here">从这里开始</h2></div>
      <p>三篇文章，理解我如何看 AI、产品与极简构建。</p>
    </div>
    <div class="start-grid">
      {startHere.map((post, index) => (
        <a href={link(`posts/${post.slug}`)}>
          <span>{String(index + 1).padStart(2, "0")} / {post.series}</span>
          <h3>{post.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section id="latest" class="latest-section">
    <div class="section-label">最新文章</div>
    <div class="post-list">
      {latestPosts.map((post) => (
        <article class="post-row">
          <div>
            <div class="post-meta"><span style={`--accent:${topicAccent[post.topic]}`}>{post.topic}</span><time>{post.date} · {post.readTime}</time></div>
            <h3><a href={link(`posts/${post.slug}`)}>{post.title}</a></h3>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={link("posts")}>查看全部文章 <span>→</span></a>
  </section>
</Base>
