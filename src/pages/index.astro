---
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import { posts } from "../data/posts";

const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path}`;
const startHere = posts.filter((post) => post.startHere).slice(0, 3);
const latestPosts = posts.slice(0, 4);
---

<Base
  title="tinylion1024 — 产品、AI 与增长实践"
  description="研究产品判断、AI 构建与增长验证，并把想法做成真正被使用的产品。"
  languageUrl="/en/"
  alternates={[{ lang: "zh-CN", href: "/" }, { lang: "en", href: "/en/" }]}
>
  <section class="hero">
    <img class="avatar" src={link("avatar.png")} alt="tinylion1024 的像素风狮子头像" width="460" height="460" />
    <div class="hero-copy">
      <h1>构建产品，验证判断。</h1>
      <p>你好，我是 @tinylion1024。我研究产品判断、AI 构建与增长验证，也把这些想法做成真正可用的东西。</p>
      <div class="hero-foot">
        <p class="hero-manifesto">从判断到交付，再到真实使用。</p>
        <div class="social-links"><a href="https://github.com/tinylion1024" target="_blank" rel="noreferrer">GitHub</a><a href="mailto:shaowei_job@163.com">Email</a><a href={link("about")}>About</a></div>
      </div>
    </div>
  </section>

  <section class="start-section" aria-labelledby="start-here">
    <div class="section-heading">
      <h2 id="start-here">从这里开始</h2>
      <p>三篇文章，理解我如何看产品、AI 构建与增长。</p>
    </div>
    <div class="start-grid">
      {startHere.map((post) => (
        <a href={link(`posts/${post.slug}`)}>
          <h3>{post.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section id="latest" class="latest-section">
    <div class="section-label">最新文章</div>
    <div class="post-list">
      {latestPosts.map((post) => (
        <article class="post-row">
          <div>
            <h3><a href={link(`posts/${post.slug}`)}>{post.title}</a></h3>
            <div class="post-meta"><time>{post.date} · {post.readTime}</time></div>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={link("posts")}>查看全部文章 <span>→</span></a>
  </section>
  <Newsletter />
</Base>
