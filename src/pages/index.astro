---
import Base from "../layouts/Base.astro";
import RssLink from "../components/RssLink.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { posts } from "../data/posts";

const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path}`;
const startHere = posts.filter((post) => post.startHere).slice(0, 3);
const latestPosts = posts.slice(0, 4);
---

<Base
  title="tinylion1024 — 产品、AI 与增长实践"
  description="研究产品判断、AI 构建与增长验证，并把想法做成真正被使用的产品。"
  languageUrl="/en/"
  alternates={[{ lang: "zh-CN", href: "/" }, { lang: "en", href: "/en/" }]}
>
  <section class="hero">
    <img class="avatar" src={link("avatar.png")} alt="tinylion1024 的像素风狮子头像" width="1024" height="1024" />
    <div class="hero-copy">
      <h1>你好，我是 @tinylion1024。<RssLink href={link("rss.xml")} label="订阅 RSS" /></h1>
      <div class="hero-summary">
        <p>研究 AI 产品、Agent 工程与增长系统，记录技术变化背后的产品与商业判断。</p>
        <SocialLinks aboutHref={link("about")} />
      </div>
    </div>
  </section>

  <section class="start-section" aria-labelledby="start-here">
    <div class="section-heading">
      <h2 id="start-here">从这里开始</h2>
    </div>
    <div class="start-grid">
      {startHere.map((post) => (
        <a href={link(`posts/${post.slug}`)}>
          <h3>{post.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="editorial-focus" aria-labelledby="editorial-focus">
    <div class="section-heading">
      <h2 id="editorial-focus">长期关注</h2>
    </div>
    <div class="focus-tags" aria-label="长期关注的五个主题">
      <span>模型与推理</span>
      <span>Agent 产品与体验</span>
      <span>AI 软件工程</span>
      <span>AI 商业与增长</span>
      <span>AI 与社会</span>
    </div>
  </section>

  <section id="latest" class="latest-section">
    <div class="section-label">最新文章</div>
    <div class="post-list">
      {latestPosts.map((post) => (
        <article class="post-row">
          <div>
            <h3><a href={link(`posts/${post.slug}`)}>{post.title}</a></h3>
            <div class="post-meta"><time>{post.date} · {post.readTime}</time>{post.series && <span> · {post.series}</span>}</div>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={link("posts")}>查看全部文章 <span>→</span></a>
  </section>
</Base>
