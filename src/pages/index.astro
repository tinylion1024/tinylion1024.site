---
import Base from "../layouts/Base.astro";
import { posts, topicAccent } from "../data/posts";

const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}/${path}`;
---

<Base>
  <section class="hero">
    <img class="avatar" src={link("avatar.png")} alt="tinylion1024 的像素风狮子头像" width="460" height="460" />
    <div>
      <h1>你好，我是 @tinylion1024。</h1>
      <p>产品人、增长实践者和技术爱好者。在这里记录产品判断、增长实验、技术工具，以及一些仍在形成中的个人思考。</p>
      <div class="social-links"><a href="https://github.com/tinylion1024" target="_blank" rel="noreferrer">GitHub</a><a href="mailto:hello@example.com">Email</a><a href={link("about")}>About</a></div>
    </div>
  </section>

  <section id="latest" class="latest-section">
    <div class="section-label">最新文章</div>
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <div>
            <div class="post-meta"><span style={`--accent:${topicAccent[post.topic]}`}>{post.topic}</span><time>{post.date} · {post.readTime}</time></div>
            <h3><a href={link(`posts/${post.slug}`)}>{post.title}</a></h3>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={link("posts")}>查看全部文章 <span>→</span></a>
  </section>
</Base>
