---
import Base from "../layouts/Base.astro";
import { posts, topicAccent } from "../data/posts";

---

<Base>
  <section class="hero">
    <img class="avatar" src="/avatar.png" alt="Tinylion 的像素风狮子头像" width="460" height="460" />
    <div>
      <h1>你好，我是 @tinylion。</h1>
      <p>产品人、增长实践者和技术爱好者。在这里记录产品判断、增长实验、技术工具，以及一些仍在形成中的个人思考。</p>
      <div class="social-links"><a href="https://github.com" target="_blank" rel="noreferrer">GitHub</a><a href="mailto:hello@example.com">Email</a><a href="/about">About</a></div>
    </div>
  </section>

  <section id="latest" class="latest-section">
    <div class="section-label">最新文章</div>
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <div>
            <div class="post-meta"><span style={`--accent:${topicAccent[post.topic]}`}>{post.topic}</span><time>{post.date} · {post.readTime}</time></div>
            <h3><a href={`/posts/${post.slug}`}>{post.title}</a></h3>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href="/posts">查看全部文章 <span>→</span></a>
  </section>
</Base>
