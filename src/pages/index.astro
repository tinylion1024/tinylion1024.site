---
import Base from "../layouts/Base.astro";
import { posts, topicAccent } from "../data/posts";

const base = import.meta.env.BASE_URL;
const link = (path = "") => `${base}${base.endsWith("/") ? "" : "/"}${path}`;
---

<Base
  title="tinylion1024 — AI 时代的极简产品实践者"
  description="用更少的工具、更清晰的判断，把想法变成真正被使用的产品。"
  languageUrl="/en/"
  alternates={[{ lang: "zh-CN", href: "/" }, { lang: "en", href: "/en/" }]}
>
  <section class="hero">
    <img class="avatar" src={link("avatar.png")} alt="tinylion1024 的像素风狮子头像" width="460" height="460" />
    <div class="hero-copy">
      <div class="hero-kicker">AI × PRODUCT × LESS</div>
      <h1>少一点复杂，<br />多一点价值。</h1>
      <p>你好，我是 @tinylion1024，一名 AI 时代的极简产品实践者。我用 AI 构建产品，用真实增长验证判断。</p>
      <p class="hero-manifesto">Less complexity. Better products.</p>
      <div class="social-links"><a href="https://github.com/tinylion1024" target="_blank" rel="noreferrer">GitHub</a><a href="mailto:shaowei_job@163.com">Email</a><a href={link("about")}>About</a></div>
    </div>
  </section>

  <section id="latest" class="latest-section">
    <div class="section-label">最新文章</div>
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <div>
            <div class="post-meta"><span style={`--accent:${topicAccent[post.topic]}`}>{post.topic}</span><time>{post.date} · {post.readTime}</time></div>
            <h3><a href={link(`posts/${post.slug}`)}>{post.title}</a></h3>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={link("posts")}>查看全部文章 <span>→</span></a>
  </section>
</Base>
